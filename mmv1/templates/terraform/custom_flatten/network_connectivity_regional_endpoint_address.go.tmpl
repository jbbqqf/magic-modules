func flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d *schema.ResourceData, config *transport_tpg.Config) interface{} {
	// The API stores the literal IPv4 address regardless of whether the user
	// supplied an IP literal or a Compute Address resource URI on create.
	// Echoing the API value back to state when the config used a URI form
	// triggers a permadiff (URI vs IP) on every refresh, which is fatal because
	// the field is ForceNew. Preserve the configured form when both refer to
	// the same address.
	if v == nil {
		return v
	}
	configured, ok := d.GetOk("address")
	if !ok {
		return v
	}
	configuredStr, ok := configured.(string)
	if !ok {
		return v
	}
	apiStr, ok := v.(string)
	if !ok {
		return v
	}
	// If the configured value is a Compute Address resource URI and the API
	// returned an IP literal (no path separators), keep the URI in state. We
	// do not validate that the URI's address resolves to apiStr - the create
	// call would have failed earlier if they disagreed.
	if strings.Contains(configuredStr, "/addresses/") && !strings.Contains(apiStr, "/") {
		return configuredStr
	}
	return v
}
