resource "google_bigquery_dataset" "test" {
	dataset_id = "{{index $.Vars "dataset_id"}}"
}

resource "google_bigquery_routine" "sproc" {
  dataset_id      = google_bigquery_dataset.test.dataset_id
  routine_id      = "{{index $.Vars "routine_id"}}"
  routine_type    = "AGGREGATE_FUNCTION"
  language        = "SQL"
  definition_body = "SUM(x) / COUNT(x)"
  arguments {
    name      = "x"
    data_type = jsonencode({ "typeKind" : "FLOAT64" })
  }
  return_type = jsonencode({ "typeKind" : "FLOAT64" })
}
